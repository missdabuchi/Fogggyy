local themeHooks = {}

local function resolve(colorOrKey)
	if type(colorOrKey) == "string" then
		return PALETTE[colorOrKey]
	end
	return colorOrKey
end

local function bind(inst, prop, colorOrKey)
	if type(colorOrKey) == "string" then
		table.insert(bindings, { inst, prop, colorOrKey })
	end
	inst[prop] = resolve(colorOrKey)
end

local function onTheme(fn)
	table.insert(themeHooks, fn)
	fn()
end

