local function applyTheme(themeName)
	local theme = THEMES[themeName]
	if not theme then
		return
	end
	currentTheme = themeName

	for key, color in pairs(theme.colors) do
		PALETTE[key] = color
	end
	for _, entry in ipairs(bindings) do
		entry[1][entry[2]] = PALETTE[entry[3]]
	end
	for _, entry in ipairs(gradientBindings) do
		entry[1].Color = ColorSequence.new(resolve(entry[2]), resolve(entry[3]))
	end

	toggleBtn.Text = theme.icon
	leafAccent.Text = theme.leaf
	blossomAccent.Text = theme.blossom

	for _, hook in ipairs(themeHooks) do
		hook()
	end

	if root.Visible then
		uiScale.Scale = 0.97
		TweenService:Create(
			uiScale,
			TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
	end
end

