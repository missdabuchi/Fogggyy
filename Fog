		TextSize = 13,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})

	local valuePill = create("TextLabel", {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 9),
		BackgroundColor3 = "Soft",
		BorderSizePixel = 0,
		Text = format(initialVal),
		TextColor3 = "Deep",
		TextSize = 12,
		Font = FONT,
		Parent = card,
	})
	round(valuePill, FULL)
	padding(valuePill, 10, 10, 0, 0)

	local hit = create("TextButton", {
		Size = UDim2.new(1, -28, 0, 28),
		Position = UDim2.new(0, 14, 0, 32),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
	})
	local bar = create("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.new(0, 0, 0.5, -4),
		BackgroundColor3 = "Soft",
		BorderSizePixel = 0,
		Parent = hit,
	})
	round(bar, FULL)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = bar,
	})
	round(fill, FULL)
	gradient(fill, "Accent", "Dark", 0)

	local knob = create("Frame", {
		Size = UDim2.fromOffset(20, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hit,
	})
	round(knob, FULL)
	stroke(knob, "Dark", 3)

	local function setVisual(value)
		local ratio = math.clamp((value - minVal) / (maxVal - minVal), 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		valuePill.Text = format(value)
	end
	setVisual(initialVal)

	local multiplier = 10 ^ decimals
	bindDrag(hit, function(input)
		local ratio = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = math.round((minVal + ratio * (maxVal - minVal)) * multiplier) / multiplier
		setVisual(value)
		callback(value)
	end)

	return setVisual
end

