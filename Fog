	local preview = newCard(96)
	create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 38),
		Position = UDim2.new(0, 14, 0, 8),
		BackgroundTransparency = 1,
		Text = "Aa Bb Cc 123",
		TextColor3 = "Deep",
		TextSize = 28,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = preview,
	})
	create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.new(0, 14, 0, 48),
		BackgroundTransparency = 1,
		Text = "Soft fog, warm tea & cozy skies",
		TextColor3 = "TextDark",
		TextSize = 13,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = preview,
	})
	local status = create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 16),
		Position = UDim2.new(0, 14, 0, 72),
		BackgroundTransparency = 1,
		Text = "Menu font: " .. FONT_BY_ID[currentFontId].name,
		TextColor3 = "TextMuted",
		TextSize = 11,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = preview,
	})
	setFontStatus = function(text)
		status.Text = text
	end

	local card = newAutoCard()
	padding(card, 8, 8, 8, 8)
	create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 42),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = card,
	})

	local outlines = {}
	for index, choice in ipairs(FONT_CHOICES) do
		local _, btn, outline = makeTile(card, {
			text = choice.name,
			color = "Accent",
			color2 = "Dark",
			textSize = 14,
			font = Enum.Font.GothamBold,
			order = index,
			hover = 1.06,
		})
		outlines[choice.id] = outline
		fontTiles[choice.id] = btn
		btn.MouseButton1Click:Connect(function()
			playSound(CLICK_SOUND_ID, 0.35, 1.3)
			selectFont(choice)
		end)
	end

	refreshFontHighlight = function()
		for id, outline in pairs(outlines) do
			local selected = id == currentFontId
			outline.Color = selected and PALETTE.Deep or WHITE
			outline.Thickness = selected and 3.5 or 2
		end
	end
	onTheme(refreshFontHighlight)

	createToggleSwitch("Also change game text", applyToGame, function(state)
		applyToGame = state
		local face = pickedFontId and fontFaces[pickedFontId]
		if state and face then
			applyGameFont(face)
		else
			restoreGameFonts()
		end
	end, "Turn off to bring the game's fonts back")
end

