local DEFAULT_LIGHTING = {
	FogColor = Lighting.FogColor,
	FogStart = Lighting.FogStart,
	FogEnd = Lighting.FogEnd,
	Brightness = Lighting.Brightness,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	ClockTime = Lighting.ClockTime,
}

local FOG_OFF_DISTANCE = 1e7

local fogEnabled = true
local userFogEnd = DEFAULT_LIGHTING.FogEnd
local fadeTime = DEFAULT_FADE_TIME

-- Properties the user has touched. They get re-applied every frame so the game can't override them.
local forced = {}

-- Hide the game's Atmosphere (it overrides Lighting fog) and bring it back later
local hiddenAtmospheres = {}
local atmosphereConn

local function hideAtmosphere(obj)
	if obj:IsA("Atmosphere") and hiddenAtmospheres[obj] == nil then
		hiddenAtmospheres[obj] = obj.Parent
		obj.Parent = nil
	end
end

local function suppressAtmosphere()
	if atmosphereConn then
		return
	end
	for _, child in ipairs(Lighting:GetChildren()) do
		hideAtmosphere(child)
	end
	-- if the game re-adds an Atmosphere later, hide that too
	atmosphereConn = Lighting.ChildAdded:Connect(hideAtmosphere)
end

local function restoreAtmosphere()
	if atmosphereConn then
		atmosphereConn:Disconnect()
		atmosphereConn = nil
	end
	for atmo, parent in pairs(hiddenAtmospheres) do
		pcall(function()
			atmo.Parent = parent
		end)
	end
	table.clear(hiddenAtmospheres)
end

local function setLighting(prop, value)
	forced[prop] = value
	if prop == "FogColor" or prop == "FogStart" or prop == "FogEnd" then
		suppressAtmosphere()
	end
	Lighting[prop] = value
end

local function applyFogEnd()
	setLighting("FogEnd", fogEnabled and userFogEnd or FOG_OFF_DISTANCE)
end

local transitionToken = 0 -- bumping this cancels a running fade

local function restoreDefaults()
	transitionToken = transitionToken + 1
	table.clear(forced)
	restoreAtmosphere()
	Lighting.FogColor = DEFAULT_LIGHTING.FogColor
	Lighting.FogStart = DEFAULT_LIGHTING.FogStart
	Lighting.FogEnd = DEFAULT_LIGHTING.FogEnd
	Lighting.Brightness = DEFAULT_LIGHTING.Brightness
	Lighting.Ambient = DEFAULT_LIGHTING.Ambient
	Lighting.OutdoorAmbient = DEFAULT_LIGHTING.OutdoorAmbient
	Lighting.ClockTime = DEFAULT_LIGHTING.ClockTime
	fogEnabled = true
	userFogEnd = DEFAULT_LIGHTING.FogEnd
end

