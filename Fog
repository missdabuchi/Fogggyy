	local function render(animate)
		local colorGoal = state and PALETTE.Dark or PALETTE.SwitchOff
		local posGoal = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
		if animate then
			TweenService:Create(switchBtn, tweenInfo, { BackgroundColor3 = colorGoal }):Play()
			TweenService:Create(knob, tweenInfo, { Position = posGoal }):Play()
		else
			switchBtn.BackgroundColor3 = colorGoal
			knob.Position = posGoal
		end
	end
	render(false)
	onTheme(function()
		render(false)
