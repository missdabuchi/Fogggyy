local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do
	B64_LOOKUP[string.byte(B64_CHARS, i)] = i - 1
end

local function decodeBase64(text)
	text = string.gsub(text, "[^%w%+/=]", "")
	local out, count = {}, 0
	for i = 1, #text, 4 do
		local a, b, c, d = string.byte(text, i, i + 3)
		local n = (B64_LOOKUP[a] or 0) * 262144
			+ (B64_LOOKUP[b] or 0) * 4096
			+ (B64_LOOKUP[c] or 0) * 64
			+ (B64_LOOKUP[d] or 0)
		local b1 = math.floor(n / 65536)
		local b2 = math.floor(n / 256) % 256
		local b3 = n % 256
		count = count + 1
		if d == 61 then
			out[count] = (c == 61) and string.char(b1) or string.char(b1, b2)
		else
			out[count] = string.char(b1, b2, b3)
		end
	end
	return table.concat(out)
end

local fontFaces = {}

local function buildFace(choice)
	if choice.assetId then
		local ok, face = pcall(function()
			return Font.new("rbxassetid://" .. choice.assetId)
		end)
		if ok and face then
			return face
		end
		return nil, "couldn't load font asset " .. tostring(choice.assetId)
	end

	local toAsset = getcustomasset or getsynasset
	if type(writefile) ~= "function" or type(toAsset) ~= "function" then
		return nil, "Custom fonts need an executor with writefile + getcustomasset"
	end
	local data = FONT_DATA[choice.id]
	if not data then
		return nil, "font data missing in the script"
	end

	local jsonFile = string.gsub(choice.file, "%.%w+$", "") .. ".json"
	local ok, result = pcall(function()
		writefile(choice.file, decodeBase64(data))
		writefile(
			jsonFile,
			HttpService:JSONEncode({
				name = choice.name,
				faces = {
					{ name = "Regular", weight = 400, style = "normal", assetId = toAsset(choice.file) },
				},
			})
		)
		return Font.new(toAsset(jsonFile), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end)
	if ok and result then
		return result
	end
	return nil, "couldn't load " .. choice.name .. " (" .. tostring(result) .. ")"
end

local function getFace(choice)
	if not fontFaces[choice.id] then
		local face, reason = buildFace(choice)
		if not face then
			return nil, reason
		end
		fontFaces[choice.id] = face
	end
	return fontFaces[choice.id]
end

local function applyMenuFont(face)
	activeFace = face
	for _, obj in ipairs(menuTexts) do
		obj.FontFace = face
	end
end

local gameOriginals = setmetatable({}, { __mode = "k" })
local gameConnection

local function styleGameText(obj, face)
	if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not obj:IsDescendantOf(screenGui) then
		if gameOriginals[obj] == nil then
			gameOriginals[obj] = obj.FontFace
		end
		obj.FontFace = face
	end
end

local function restoreGameFonts()
	if gameConnection then
		gameConnection:Disconnect()
		gameConnection = nil
	end
	for obj, original in pairs(gameOriginals) do
		pcall(function()
			obj.FontFace = original
		end)
	end
	table.clear(gameOriginals)
end

local function applyGameFont(face)
	if gameConnection then
		gameConnection:Disconnect()
		gameConnection = nil
	end
	for _, obj in ipairs(playerGui:GetDescendants()) do
		styleGameText(obj, face)
	end
	gameConnection = playerGui.DescendantAdded:Connect(function(obj)
		styleGameText(obj, face)
	end)
end

table.insert(cleanupHooks, restoreGameFonts)

local currentFontId = FONT_BY_ID[DEFAULT_FONT] and DEFAULT_FONT or "chicken_pie"
local pickedFontId
local applyToGame = APPLY_FONT_TO_GAME
local setFontStatus
local refreshFontHighlight

local function selectFont(choice, silent)
	local face, reason = getFace(choice)
	if not face then
		if setFontStatus then
			setFontStatus("⚠ " .. reason)
		end
		warn("[Fog Changer] " .. reason)
		if not silent then
			notify(reason, "⚠", true, 4)
		end
		return false
	end
	currentFontId = choice.id
	applyMenuFont(face)

	if not silent then
		pickedFontId = choice.id
		if applyToGame then
			applyGameFont(face)
		else
			restoreGameFonts()
		end
		notify("Font: " .. choice.name, "🔤", true, 2)
	end

	if setFontStatus then
		setFontStatus(silent and ("Menu font: " .. choice.name) or ("Font: " .. choice.name))
	end
	if refreshFontHighlight then
		refreshFontHighlight()
	end
	return true
end

local fontTiles = {}

