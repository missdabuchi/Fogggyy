local moodOutlines = {}
local activeMoodId

local function refreshMoodHighlight()
	for id, outline in pairs(moodOutlines) do
		local selected = id == activeMoodId
		outline.Color = selected and PALETTE.Deep or WHITE
		outline.Thickness = selected and 3.5 or 2
	end
end

local function setActiveMood(id)
	activeMoodId = id
	refreshMoodHighlight()
end

local function fadeToMood(m)
	transitionToken = transitionToken + 1
	local token = transitionToken

	local from = {
		fogColor = Lighting.FogColor,
		fogStart = Lighting.FogStart,
		fogEnd = math.max(fogEnabled and userFogEnd or m.finish, 1),
		clock = Lighting.ClockTime,
		bright = Lighting.Brightness,
		ambient = Lighting.Ambient,
		outdoor = Lighting.OutdoorAmbient,
	}
	fogEnabled = true

	local clockDiff = ((m.clock - from.clock + 12) % 24) - 12

	local function step(e)
		userFogEnd = (e >= 1) and m.finish or from.fogEnd * (m.finish / from.fogEnd) ^ e
		setLighting("FogColor", from.fogColor:Lerp(m.fog, e))
		setLighting("FogStart", from.fogStart + (m.start - from.fogStart) * e)
		setLighting("ClockTime", (from.clock + clockDiff * e) % 24)
		setLighting("Brightness", from.bright + (m.bright - from.bright) * e)
		if presetAmbient then
			setLighting("Ambient", from.ambient:Lerp(m.ambient, e))
		end
		if presetOutdoor then
			setLighting("OutdoorAmbient", from.outdoor:Lerp(m.outdoor, e))
		end
		applyFogEnd()
	end

	if fadeTime <= 0 then
		step(1)
		return
	end

	task.spawn(function()
		local startTime = os.clock()
		while token == transitionToken and screenGui.Parent do
			local alpha = math.clamp((os.clock() - startTime) / fadeTime, 0, 1)
			step(TweenService:GetValue(alpha, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
			if alpha >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

local function applyMood(m)
	fadeToMood(m)
	setActiveMood(m.id)

	updaters.fogToggle(true)
	updaters.fogStart(m.start)
	updaters.fogEnd(m.finish)
	updaters.fogColor(m.fog)
	updaters.clockTime(m.clock)
	updaters.brightness(m.bright)
	if presetAmbient then
		updaters.ambient(m.ambient)
	end
	if presetOutdoor then
		updaters.outdoorAmbient(m.outdoor)
	end
end

